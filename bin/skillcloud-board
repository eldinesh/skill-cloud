#!/bin/bash
# skillcloud-board: read and render the team board (ux/team/board/*.md tickets).
#
#   skillcloud-board summary     counts, what waits on people, the frontier
#   skillcloud-board frontier    ready + afk tickets whose blockers are done and whose resources are free
#   skillcloud-board waiting     hitl / needs-you tickets with their question
#   skillcloud-board stranded    tickets that can't start because a blocker was dropped
#   skillcloud-board list [status]
#   skillcloud-board html [out]  render a self-contained board page (default ux/team/board.html)
#
# Run from the project root (or set SC_PROJECT). Plain files in, plain text or one HTML file out.
# Compatible with macOS /bin/bash 3.2. No network, no dependencies beyond awk/sed.

set -u
# Split only on newlines: project folders often have spaces in their names ("Collaterals Final 2").
IFS=$'\n'
ROOT="${SC_PROJECT:-$(pwd)}"
BOARD="$ROOT/ux/team/board"

field() { # field <file> <key> -> raw value (frontmatter only)
  awk -v k="$2" 'NR==1&&$0=="---"{f=1;next} f&&$0=="---"{exit}
    f{ if (index($0, k":")==1) { v=substr($0, length(k)+2); sub(/^[ \t]+/,"",v); sub(/[ \t]+#.*$/,"",v); if (v=="\"\"" || v=="[]") v=""; print v; exit } }' "$1"
}
list_items() { # "[a, b]" -> one per line
  echo "$1" | sed 's/^\[//; s/\]$//' | tr ',' '\n' | sed 's/^[ \t]*//; s/[ \t]*$//; s/^"//; s/"$//' | grep -v '^$' || true
}
tickets() { ls "$BOARD"/*.md 2>/dev/null || true; }
status_of() { [ -f "$BOARD/$1.md" ] && field "$BOARD/$1.md" status || echo "missing"; }

need_board() {
  if [ ! -d "$BOARD" ]; then echo "BOARD: none (no ux/team/board/ in $ROOT)"; exit 0; fi
}

is_frontier() { # is_frontier <file>
  local f="$1" st md b u held
  st=$(field "$f" status); md=$(field "$f" mode)
  [ "$st" = "ready" ] || return 1
  [ "$md" = "afk" ] || return 1
  for b in $(list_items "$(field "$f" blockedBy)"); do
    [ "$(status_of "$b")" = "done" ] || return 1
  done
  for u in $(list_items "$(field "$f" uses)"); do
    for t in $(tickets); do
      [ "$t" = "$f" ] && continue
      [ "$(field "$t" status)" = "doing" ] || continue
      list_items "$(field "$t" uses)" | grep -qx "$u" && return 1
    done
  done
  return 0
}

for_you_question() {
  awk '/^## For you/{f=1;next} /^## /{f=0} f && /\*\*Question:\*\*/{sub(/.*\*\*Question:\*\*[ ]*/,""); print; exit}' "$1"
}

cmd_list() {
  need_board
  local want="${1:-}"
  for f in $(tickets); do
    st=$(field "$f" status)
    [ -n "$want" ] && [ "$st" != "$want" ] && continue
    printf "%-12s %-10s %-6s %-9s %-22s %s\n" "$(field "$f" id)" "$st" "$(field "$f" mode)" "$(field "$f" stage)" "$(field "$f" role)" "$(field "$f" title)"
  done
}

blocked_by_dropped() { # prints the dropped blockers of a ticket, if any
  local f="$1" b
  for b in $(list_items "$(field "$f" blockedBy)"); do
    [ "$(status_of "$b")" = "dropped" ] && printf "%s " "$b"
  done
}

cmd_stranded() { # tickets that can never start because a blocker was dropped
  need_board
  local n=0 d st
  for f in $(tickets); do
    st=$(field "$f" status)
    case "$st" in done|dropped) continue ;; esac
    d=$(blocked_by_dropped "$f")
    [ -z "$d" ] && continue
    printf "%-10s %-22s needs dropped: %s\n" "$(field "$f" id)" "$(field "$f" role)" "$d"
    n=$((n + 1))
  done
  [ "$n" -eq 0 ] && echo "(nothing stranded)"
  return 0
}

cmd_frontier() {
  need_board
  local n=0
  for f in $(tickets); do
    if is_frontier "$f"; then
      printf "%-10s %-22s %-12s %s\n" "$(field "$f" id)" "$(field "$f" role)" "$(field "$f" route)" "$(field "$f" title)"
      n=$((n + 1))
    fi
  done
  [ "$n" -eq 0 ] && echo "(frontier empty)"
  return 0
}

cmd_waiting() {
  need_board
  local n=0
  for f in $(tickets); do
    st=$(field "$f" status); md=$(field "$f" mode)
    if { [ "$md" = "hitl" ] && [ "$st" = "ready" ]; } || [ "$st" = "needs-you" ]; then
      blocked=""
      for b in $(list_items "$(field "$f" blockedBy)"); do
        [ "$(status_of "$b")" = "done" ] || blocked="$blocked $b"
      done
      [ -n "$blocked" ] && continue
      q=$(for_you_question "$f")
      printf "%-12s %-16s %s\n" "$(field "$f" id)" "$(field "$f" role)" "${q:-$(field "$f" title)}"
      n=$((n + 1))
    fi
  done
  [ "$n" -eq 0 ] && echo "(nothing waits on people)"
  return 0
}

cmd_summary() {
  need_board
  local s c
  printf "BOARD %s\n" "$BOARD"
  for s in proposed ready doing review needs-you done dropped; do
    c=0
    for f in $(tickets); do [ "$(field "$f" status)" = "$s" ] && c=$((c + 1)); done
    [ "$c" -gt 0 ] && printf "  %-10s %d\n" "$s" "$c"
  done
  echo "WAITS ON PEOPLE"; cmd_waiting | sed 's/^/  /'
  echo "FRONTIER"; cmd_frontier | sed 's/^/  /'
  echo "STRANDED (a blocker was dropped: decide before they can run)"; cmd_stranded | sed 's/^/  /'
  echo "DOING"; local d=0
  for f in $(tickets); do
    if [ "$(field "$f" status)" = "doing" ]; then
      printf "  %-10s %-22s %s\n" "$(field "$f" id)" "$(field "$f" role)" "$(field "$f" title)"; d=$((d + 1))
    fi
  done
  [ "$d" -eq 0 ] && echo "  (nothing running)"
  return 0
}

esc() { sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g'; }

card() { # card <file> <column>
  local f="$1" id title stage role route st md verdict body q cls
  id=$(field "$f" id | esc); title=$(field "$f" title | esc); stage=$(field "$f" stage | esc)
  role=$(field "$f" role | esc); route=$(field "$f" route | esc); st=$(field "$f" status | esc)
  md=$(field "$f" mode | esc); verdict=$(field "$f" verdict | esc)
  q=$(for_you_question "$f" | esc)
  body=$(awk 'NR==1&&$0=="---"{f=1;next} f&&$0=="---"{f=0;b=1;next} b{print}' "$f" | esc)
  cls="card stage-$stage"
  [ "$md" = "hitl" ] && cls="$cls hitl"
  printf '<details class="%s" data-id="%s"><summary><span class="id">%s</span> <span class="title">%s</span>' "$cls" "$id" "$id" "$title"
  printf '<span class="meta"><span class="chip">%s</span><span class="chip">%s</span>' "$stage" "$role"
  [ -n "$route" ] && printf '<span class="chip route">%s</span>' "$route"
  [ -n "$verdict" ] && printf '<span class="chip v-%s">%s</span>' "$verdict" "$verdict"
  printf '</span>'
  [ -n "$q" ] && printf '<span class="q">%s</span>' "$q"
  printf '</summary><pre>%s</pre></details>\n' "$body"
}

ticket_json() { # one ticket file -> one JSON object
  awk -v file="$(basename "$1")" '
    function q(s) { gsub(/\\/,"\\\\",s); gsub(/"/,"\\\"",s); gsub(/\t/," ",s); gsub(/\r/,"",s); gsub(/<\//,"<\\/",s); return "\"" s "\"" }
    function clean(s) { sub(/^[ \t]+/,"",s); sub(/[ \t]+#.*$/,"",s); if (s=="\"\"" || s=="[]") s=""; gsub(/^"|"$/,"",s); return s }
    function arr(s,   n,i,parts,out) { s=clean(s); gsub(/^\[|\]$/,"",s); n=split(s,parts,","); out=""; for (i=1;i<=n;i++) { gsub(/^[ \t"]+|[ \t"]+$/,"",parts[i]); if (parts[i]!="") out=out (out==""?"":",") q(parts[i]) } return "[" out "]" }
    NR==1 && $0=="---" { fm=1; next }
    fm && $0=="---" { fm=0; next }
    fm { k=$0; sub(/:.*/,"",k); v=$0; sub(/^[^:]*:/,"",v); f[k]=v; next }
    /^##[ \t]+/ { sec=tolower($0); sub(/^##[ \t]+/,"",sec); sub(/[ \t]+$/,"",sec); next }
    sec!="" { if ($0 ~ /^<!--/ ) next; b[sec]=b[sec] (b[sec]==""?"":"\n") $0
      if (sec=="for you" && $0 ~ /\*\*Question:\*\*/) { qq=$0; sub(/.*\*\*Question:\*\*[ ]*/,"",qq); question=qq }
      if (sec=="log" && $0 ~ /^[ \t]*-/) { logs[++nl]=$0 } }
    END {
      lg=""; for (i=(nl>6?nl-5:1); i<=nl; i++) lg=lg (lg==""?"":",") q(logs[i])
      for (k in b) { x=b[k]; sub(/^[\n ]+/,"",x); sub(/[\n ]+$/,"",x); b[k]=x }
      id=clean(f["id"]); if (id=="") { id=file; sub(/\.md$/,"",id) }
      printf "{\"id\":%s,\"title\":%s,\"stage\":%s,\"kind\":%s,\"mode\":%s,\"role\":%s,\"status\":%s,\"route\":%s,\"verdict\":%s,\"blockedBy\":%s,\"question\":%s,\"what\":%s,\"doneWhen\":%s,\"log\":[%s]}",
        q(id), q(clean(f["title"])), q(clean(f["stage"])), q(clean(f["kind"])==""?"job":clean(f["kind"])), q(clean(f["mode"])==""?"afk":clean(f["mode"])),
        q(clean(f["role"])), q(clean(f["status"])==""?"proposed":clean(f["status"])), q(clean(f["route"])), q(clean(f["verdict"])), arr(f["blockedBy"]),
        q(question), q(b["what"]), q(b["done when"]), lg
    }' "$1"
}

cmd_html() {
  local out="${1:-$ROOT/ux/team/board.html}" project now tpl data first=1 f events
  tpl="$(cd "$(dirname "$0")" && pwd)/board-app.html"
  [ -f "$tpl" ] || { echo "board template missing: $tpl"; exit 2; }
  project=$(field "$ROOT/ux/project-context.md" project 2>/dev/null)
  [ -z "$project" ] && project=$(basename "$ROOT")
  now=$(date '+%Y-%m-%dT%H:%M:%S')
  events="[]"
  if [ -d "$ROOT/ux/.history" ]; then
    events=$(cd "$ROOT" && "$(dirname "$0")/skillcloud-history" log --json 2>/dev/null) || events="[]"
    [ -z "$events" ] && events="[]"
  fi
  data="$out.data.$$"
  {
    printf '{"project":"%s","generated":"%s","tickets":[' "$(printf '%s' "$project" | sed 's/\\/\\\\/g; s/"/\\"/g')" "$now"
    if [ -d "$BOARD" ]; then
      for f in $(tickets); do
        [ $first -eq 1 ] || printf ','
        first=0
        ticket_json "$f"
      done
    fi
    printf '],"events":%s}' "$events"
  } > "$data"
  awk -v title="$(printf '%s' "$project" | sed 's/[&<>]/ /g') · SkillCloud" -v datafile="$data" '
    { if (index($0, "__DATA__")) { pre=$0; sub(/__DATA__.*/, "", pre); post=$0; sub(/.*__DATA__/, "", post); printf "%s", pre; while ((getline line < datafile) > 0) printf "%s", line; print post; next }
      gsub(/__TITLE__/, title); print }' "$tpl" > "$out"
  rm -f "$data"
  echo "board: $out"
}

case "${1:-summary}" in
  summary) cmd_summary ;;
  frontier) cmd_frontier ;;
  waiting) cmd_waiting ;;
  stranded) cmd_stranded ;;
  list) shift; cmd_list "${1:-}" ;;
  html) shift; cmd_html "${1:-}" ;;
  -h|--help) sed -n '2,11p' "$0" ;;
  *) echo "unknown command: $1 (try --help)"; exit 1 ;;
esac
