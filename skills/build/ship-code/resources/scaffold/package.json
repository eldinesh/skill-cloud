{
  "name": "deliverable",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4317 --strictPort",
    "check:types": "tsc --noEmit",
    "check:lint": "eslint . --max-warnings 0",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:network": "node scripts/check-network.mjs",
    "test:unit": "vitest run",
    "check": "npm run check:types && npm run check:lint && npm run check:tokens && npm run check:secrets && npm run check:network && npm run test:unit && npm run build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "overrides": {
    "playwright-core": "1.48.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.0",
    "@eslint/js": "9.14.0",
    "@playwright/test": "1.48.2",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "eslint": "9.14.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.2",
    "eslint-plugin-react-hooks": "5.0.0",
    "globals": "15.12.0",
    "typescript": "5.6.3",
    "typescript-eslint": "8.13.0",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  }
}
