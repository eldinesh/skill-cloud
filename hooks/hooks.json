{
  "description": "SkillCloud: session wiring and the team guard (agents never sign, and write only in their lane)",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/team-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "modules": [
    "./board.tsx"
  ]
}
