#!/bin/bash
# SkillCloud installer — role-based symlinks into ~/.claude/skills/
# (read by both Claude Code and Cowork, so one install covers both surfaces).
#
# Install:
#   git clone --single-branch --depth 1 git@github.com:eldinesh/skill-cloud.git ~/.claude/skills/skill-cloud
#   cd ~/.claude/skills/skill-cloud && ./setup
#
# Usage:
#   ./setup                      interactive role picker
#   ./setup --role researcher    researcher | designer | engineer | both | core
#   ./setup --agents             also install the design-team agents (sc-*) into ~/.claude/agents
#   ./setup --no-agents          skip or remove the design-team agents
#   ./setup --update             pull latest + relink + mark "just upgraded"
#   ./setup --uninstall          remove SkillCloud symlinks and repo pointer
#   ./setup --force              replace non-SkillCloud files occupying our names
#
# Compatible with macOS /bin/bash 3.2. Idempotent — safe to re-run anytime.

set -u

REPO_ROOT=$(cd "$(dirname "$0")" && pwd)
SC_HOME="${SKILLCLOUD_HOME:-$HOME/.skillcloud}"
SKILLS_DIR="${SKILLCLOUD_SKILLS_DIR:-$HOME/.claude/skills}"
AGENTS_DIR="${SKILLCLOUD_AGENTS_DIR:-$HOME/.claude/agents}"
CONFIG="$REPO_ROOT/bin/skillcloud-config"

ROLE=""
DO_UPDATE="no"
DO_UNINSTALL="no"
FORCE="no"
AGENTS=""

while [ $# -gt 0 ]; do
  case "$1" in
    --role) ROLE="${2:-}"; shift 2 ;;
    --update) DO_UPDATE="yes"; shift ;;
    --uninstall) DO_UNINSTALL="yes"; shift ;;
    --force) FORCE="yes"; shift ;;
    --agents) AGENTS="yes"; shift ;;
    --no-agents) AGENTS="no"; shift ;;
    -h|--help) sed -n '2,18p' "$0"; exit 0 ;;
    *) echo "Unknown flag: $1 (try --help)"; exit 1 ;;
  esac
done

groups_for_role() {
  case "$1" in
    researcher) echo "core ai stages research" ;;
    designer)   echo "core ai stages design build" ;;
    engineer)   echo "core ai stages build" ;;
    both)       echo "core ai stages research design build" ;;
    core)       echo "core ai stages" ;;
    *) echo "" ;;
  esac
}

all_skill_dirs() {
  find "$REPO_ROOT/skills" -mindepth 2 -maxdepth 2 -type d 2>/dev/null
}

link_points_to_repo() {
  # $1 = path in ~/.claude/skills; true if it's a symlink into this repo
  [ -L "$1" ] || return 1
  local target
  target=$(readlink "$1")
  case "$target" in
    "$REPO_ROOT"/*) return 0 ;;
    *) return 1 ;;
  esac
}

uninstall_all() {
  local removed=0
  for d in "$SKILLS_DIR"/*; do
    [ -e "$d" ] || continue
    if link_points_to_repo "$d"; then
      rm -f "$d"
      removed=$((removed + 1))
    fi
  done
  for a in "$AGENTS_DIR"/sc-*.md; do
    [ -e "$a" ] || [ -L "$a" ] || continue
    if link_points_to_repo "$a"; then rm -f "$a"; removed=$((removed + 1)); fi
  done
  rm -f "$SC_HOME/repo"
  # Strip the skillcloud section from ~/.claude/CLAUDE.md if present
  CM="${SKILLCLOUD_CLAUDE_MD:-$HOME/.claude/CLAUDE.md}"
  if grep -qF "<!-- SKILLCLOUD_START -->" "$CM" 2>/dev/null; then
    tmp="$CM.tmp.$$"
    awk '$0 == "<!-- SKILLCLOUD_START -->" { skip = 1; next }
         $0 == "<!-- SKILLCLOUD_END -->"   { skip = 0; next }
         skip != 1 { print }' "$CM" > "$tmp" && mv "$tmp" "$CM"
    echo "Removed the skillcloud section from ~/.claude/CLAUDE.md."
  fi
  echo "Removed $removed SkillCloud skill links and the repo pointer."
  echo "Config kept at $SC_HOME/config.yaml (delete it if you're done for good)."
}

if [ "$DO_UNINSTALL" = "yes" ]; then
  uninstall_all
  exit 0
fi

if [ "$DO_UPDATE" = "yes" ]; then
  OLD_VERSION=$(cat "$REPO_ROOT/VERSION" 2>/dev/null || echo "unknown")
  if git -C "$REPO_ROOT" rev-parse --git-dir >/dev/null 2>&1; then
    if ! git -C "$REPO_ROOT" pull --ff-only 2>/dev/null; then
      echo "WARNING: git pull failed (offline, auth, or local changes). Relinking current checkout."
    fi
  fi
  mkdir -p "$SC_HOME"
  echo "$OLD_VERSION" > "$SC_HOME/just-upgraded-from"
  rm -f "$SC_HOME/last-update-check" "$SC_HOME/update-snoozed"
  ROLE=$("$CONFIG" get role)
  if [ -z "$ROLE" ]; then ROLE="core"; fi
  echo "Updating SkillCloud (was v$OLD_VERSION, role: $ROLE)..."
fi

if [ -z "$ROLE" ]; then
  SAVED_ROLE=$("$CONFIG" get role)
  echo "SkillCloud setup"
  echo ""
  echo "Which bundle fits your work?"
  echo "  1) Researcher   (core + research skills)"
  echo "  2) Designer     (core + design + build skills)"
  echo "  3) Both         (core + research + design + build)"
  echo "  4) Core only    (handbook, guardrails, design lead, rulebook)"
  echo "  5) Engineer     (core + build skills)"
  if [ -n "$SAVED_ROLE" ]; then
    echo ""
    echo "  [enter] keep current role: $SAVED_ROLE"
  fi
  printf "Choice: "
  read -r choice
  case "$choice" in
    1) ROLE="researcher" ;;
    2) ROLE="designer" ;;
    3) ROLE="both" ;;
    4) ROLE="core" ;;
    5) ROLE="engineer" ;;
    "") ROLE="${SAVED_ROLE:-both}" ;;
    *) echo "Unrecognized choice."; exit 1 ;;
  esac
fi

SC_GROUPS=$(groups_for_role "$ROLE")
if [ -z "$SC_GROUPS" ]; then
  echo "Invalid role: $ROLE (use researcher | designer | engineer | both | core)"
  exit 1
fi

mkdir -p "$SKILLS_DIR" "$SC_HOME"

# Stable pointer so skills can find bin/ regardless of where the repo was cloned
rm -f "$SC_HOME/repo"
ln -s "$REPO_ROOT" "$SC_HOME/repo"

"$CONFIG" set role "$ROLE"
"$CONFIG" set repo_path "$REPO_ROOT"

# Build the selected skill list
SELECTED=""
for group in $SC_GROUPS; do
  for d in "$REPO_ROOT/skills/$group"/*; do
    [ -d "$d" ] || continue
    [ -f "$d/SKILL.md" ] || continue
    SELECTED="$SELECTED $d"
  done
done

LINKED=0
SKIPPED=0
for src in $SELECTED; do
  name=$(basename "$src")
  dst="$SKILLS_DIR/$name"
  if [ -e "$dst" ] && [ "$dst" -ef "$REPO_ROOT" ]; then
    echo "  ! '$name' would collide with the clone itself — clone the repo as ~/.claude/skills/skill-cloud (hyphenated), not '$name'"
    SKIPPED=$((SKIPPED + 1))
    continue
  fi
  if [ -e "$dst" ] || [ -L "$dst" ]; then
    if link_points_to_repo "$dst"; then
      rm -f "$dst"
    elif [ "$FORCE" = "yes" ]; then
      echo "  ! replacing existing non-SkillCloud '$name' (--force)"
      rm -rf "$dst"
    else
      echo "  ! skipping '$name' — something else already lives at $dst (re-run with --force to replace)"
      SKIPPED=$((SKIPPED + 1))
      continue
    fi
  fi
  ln -s "$src" "$dst"
  LINKED=$((LINKED + 1))
done

# Remove our links that are no longer in the selection (e.g., role switch)
PRUNED=0
for d in "$SKILLS_DIR"/*; do
  [ -L "$d" ] || continue
  link_points_to_repo "$d" || continue
  name=$(basename "$d")
  still="no"
  for src in $SELECTED; do
    [ "$(basename "$src")" = "$name" ] && still="yes" && break
  done
  if [ "$still" = "no" ]; then
    rm -f "$d"
    PRUNED=$((PRUNED + 1))
  fi
done

# --- Design-team agents ------------------------------------------------------
# The sc-* subagents (orchestrated by /design-lead) are linked into ~/.claude/agents.
# They read skills from the repo pointer, so they work with any role. Opt-in once; remembered.
if [ -z "$AGENTS" ]; then
  SAVED_AGENTS=$("$CONFIG" get agents)
  if [ -n "$SAVED_AGENTS" ]; then
    AGENTS="$SAVED_AGENTS"
  elif [ -t 0 ] && [ "$DO_UPDATE" != "yes" ]; then
    printf "Install the design team (8 agents run by /design-lead: researcher, synthesiser, strategist,\ninformation architect, designer, quality reviewer, engineer, checker)? [Y/n] "
    read -r ans
    case "$ans" in n|N|no) AGENTS="no" ;; *) AGENTS="yes" ;; esac
  else
    AGENTS="no"
  fi
fi
"$CONFIG" set agents "$AGENTS"
A_LINKED=0
if [ "$AGENTS" = "yes" ]; then
  mkdir -p "$AGENTS_DIR"
  for src in "$REPO_ROOT"/agents/sc-*.md; do
    [ -f "$src" ] || continue
    dst="$AGENTS_DIR/$(basename "$src")"
    if [ -e "$dst" ] || [ -L "$dst" ]; then
      if link_points_to_repo "$dst" || [ "$FORCE" = "yes" ]; then rm -f "$dst"
      else echo "  ! skipping agent '$(basename "$src")' — something else already lives at $dst (--force to replace)"; continue; fi
    fi
    ln -s "$src" "$dst"
    A_LINKED=$((A_LINKED + 1))
  done
fi
# prune our agent links that are gone from the repo, or all of them when agents are off
for a in "$AGENTS_DIR"/sc-*.md; do
  [ -L "$a" ] || continue
  link_points_to_repo "$a" || continue
  if [ "$AGENTS" != "yes" ] || [ ! -f "$REPO_ROOT/agents/$(basename "$a")" ]; then rm -f "$a"; fi
done

VERSION=$(cat "$REPO_ROOT/VERSION" 2>/dev/null || echo "?")
echo ""
echo "SkillCloud v$VERSION — role: $ROLE ($LINKED skills linked, $SKIPPED skipped, $PRUNED pruned; team agents: $AGENTS, $A_LINKED linked)."
echo "Skills load in Claude Code and Cowork from ~/.claude/skills. Manage with /skillcloud."

# --- CLAUDE.md section -------------------------------------------------------
# Keep a marker-delimited "skillcloud" section in ~/.claude/CLAUDE.md so Claude
# routes to the installed skills. Offered once; refreshed silently on re-runs
# and role switches if the section already exists.

SC_MARK_START="<!-- SKILLCLOUD_START -->"
SC_MARK_END="<!-- SKILLCLOUD_END -->"
CLAUDE_MD="${SKILLCLOUD_CLAUDE_MD:-$HOME/.claude/CLAUDE.md}"

write_claude_md_section() {
  mkdir -p "$(dirname "$CLAUDE_MD")"
  touch "$CLAUDE_MD"
  tmp="$CLAUDE_MD.tmp.$$"
  awk -v s="$SC_MARK_START" -v e="$SC_MARK_END" '
    $0 == s { skip = 1; next }
    $0 == e { skip = 0; next }
    skip != 1 { print }
  ' "$CLAUDE_MD" > "$tmp"
  {
    echo "$SC_MARK_START"
    echo "## skillcloud"
    echo ""
    echo "SkillCloud is installed (internal skill system; skills live in ~/.claude/skills and work in Claude Code and Cowork)."
    echo "When a request matches one of these skills, invoke it via the Skill tool. When in doubt, invoke the skill."
    echo "Project material follows the data rules in the project's ux/project-context.md — /engagement-guardrails is the rule."
    echo "Run a project with /design-lead: it routes work to the design-team agents (when installed), has every handoff checked, and stops at each gate for a named person to sign off. Claude never signs."
    echo "Manage/update with /skillcloud. Per-project routing rules: $REPO_ROOT/docs/ROUTING.md"
    echo ""
    printf "Available skills:"
    for src in $SELECTED; do printf " /%s" "$(basename "$src")"; done
    printf "\n"
    echo "$SC_MARK_END"
  } >> "$tmp"
  mv "$tmp" "$CLAUDE_MD"
}

if grep -qF "$SC_MARK_START" "$CLAUDE_MD" 2>/dev/null; then
  write_claude_md_section
  echo "Refreshed the skillcloud section in ~/.claude/CLAUDE.md."
elif [ "$("$CONFIG" get claude_md_offered)" != "true" ]; then
  if [ -t 0 ]; then
    printf "Add a skillcloud section to ~/.claude/CLAUDE.md so Claude routes to these skills? [Y/n] "
    read -r ans
    case "$ans" in
      n|N|no) echo "Skipped. Routing rules to paste later: $REPO_ROOT/docs/ROUTING.md" ;;
      *) write_claude_md_section; echo "Added the skillcloud section to ~/.claude/CLAUDE.md." ;;
    esac
  else
    echo "Tip: add a skillcloud section to ~/.claude/CLAUDE.md (re-run ./setup interactively, or see $REPO_ROOT/docs/ROUTING.md)."
  fi
  "$CONFIG" set claude_md_offered true
fi
